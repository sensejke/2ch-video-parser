# Конфигурация для продакшена
# Скопировать в .env и отредактировать

# База данных
DATABASE_PATH=videos.db

# Redis (опционально, graceful degradation если недоступен)
REDIS_URL=redis://redis:6379

# Окружение (development/production)
ENV=production

# Домен для CORS и CDN
DOMAIN=https://yourdomain.com

# Rate limiting (запросов в минуту)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Парсер настройки
UPDATE_INTERVAL=60
MAX_PAGES_PER_BOARD=10
MAX_THREADS_PER_BOARD=50

# User-Agent для запросов
USER_AGENT=Mozilla/5.0 (compatible; 2ch-parser/1.0)
